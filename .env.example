# Copy to .env (gitignored) and fill in what you need.
# Scripts look here only after the process environment, so `export GEMINI_API_KEY=...`
# always wins. You can also point $CLIP_FACTORY_ENV at a file elsewhere,
# or keep it at ~/.clip-factory.env.

# Required: content scoring (stage 2), frame/speech consistency (gate 3),
# visual review (gate 9), and the optional faceMap pass.
GEMINI_API_KEY=

# Optional: a separate key for the video/vision calls, if you keep quotas apart.
# Falls back to GEMINI_API_KEY when unset.
GEMINI_VIDEO_API_KEY=

# Optional: the second, independent scoring pool in stage 2. Highly recommended —
# cross-model agreement is what turns a pick into a confident pick.
OPENAI_API_KEY=

# Optional: OpusClip, used only as a third opinion when hunting highlights.
OPUSCLIP_API_KEY=

# Optional: Descript, used only by scripts/dub.py for the multi-language chain.
DESCRIPT_API_KEY=
